# API
COOP_API_BASE_URL=http://localhost:8001
COOP_API_TOKEN=mock-secret

# Telegram
TELEGRAM_BOT_TOKEN=<tu-token-de-@BotFather>
# Uno o varios chat IDs autorizados, separados por coma (Álvaro, Mari, pruebas).
# También se acepta el singular TELEGRAM_OPERADOR_CHAT_ID por compatibilidad.
TELEGRAM_OPERADOR_CHAT_IDS=<chat-id-1>,<chat-id-2>

# OpenAI
OPENAI_API_KEY=<tu-api-key>

# Opcionales
APP_ENV=produccion
LOG_LEVEL=DEBUG

# WhatsApp Cloud API (opcional). Si no se configuran, el bot usa únicamente
# el fallback de enlaces wa.me para notificar a los socios.
WHATSAPP_CLOUD_API_TOKEN=<token-de-Meta-Cloud-API>
WHATSAPP_PHONE_NUMBER_ID=<phone-number-id-de-Meta>
# Plantillas de Meta (opcionales, ver docs/03-adr/ADR-010). Sin ellas, el bot
# solo puede escribirle a un socio que haya escrito en las últimas 24h.
WHATSAPP_PLANTILLA=<nombre-plantilla-recibos>
WHATSAPP_PLANTILLA_IDIOMA=es
WHATSAPP_PLANTILLA_RECORDATORIO=<nombre-plantilla-recordatorio-mora>
