# Base de datos
DATABASE_URL=postgresql://usuario:clave@host:puerto/basededatos

# Autenticación de los endpoints internos (todo salvo /health y /webhooks/whatsapp)
API_SECRET_TOKEN=<token-compartido-con-el-bot>

# Opcionales
APP_ENV=produccion
PORT=8080

# Asistente de WhatsApp para socios (ver docs/03-adr/ADR-011). Sin estas
# variables, el webhook queda montado pero no le contesta a nadie.
# Mismo token y phone_number_id que ya usa el bot (packages/bot/.env.example).
WHATSAPP_CLOUD_API_TOKEN=<token-de-Meta-Cloud-API>
WHATSAPP_PHONE_NUMBER_ID=<phone-number-id-de-Meta>
WHATSAPP_GRAPH_VERSION=v20.0
# Lo inventas tú (ej. con `openssl rand -hex 24`) y pegas el mismo valor en
# Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=<inventa-una-cadena-larga-aleatoria>
# Meta for Developers → tu App → Configuración → Básica → "Clave secreta de
# la app" (botón "Mostrar"). Verifica la firma X-Hub-Signature-256.
WHATSAPP_APP_SECRET=<app-secret-de-meta>
# Lista blanca separada por comas, ej: +573001112233,+573004445566
# Vacía o ausente = el asistente no le responde a nadie (default seguro).
# "*" = abierto a todos los socios.
WHATSAPP_ASISTENTE_NUMEROS=<numeros-de-prueba-separados-por-coma>
